@model IEnumerable<ProyectoSGIOCore.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int total     = Model.Count();
    int activos   = Model.Count(u => u.Activo);
    int inactivos = Model.Count(u => !u.Activo);
    int admins    = Model.Count(u => u.Rol?.Nombre == "Administrador");
    int supervisores = Model.Count(u => u.Rol?.Nombre == "Supervisor");
    int empleados = Model.Count(u => u.Rol?.Nombre == "Empleado");
    int usuarios  = Model.Count(u => u.Rol?.Nombre == "Usuario");
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Usuarios</h1>
        <p class="page-subtitle">Gestión de usuarios y roles del sistema</p>
    </div>
    <a asp-controller="Administrativo" asp-action="CrearUsuario" class="btn btn-primary btn-sm">
        <i class="bi bi-person-plus me-1"></i> Nuevo Usuario
    </a>
</div>

<!-- Alertas -->
@if (TempData["MensajeExito"] != null)
{
    <div class="sgio-alert success mb-3">
        <i class="bi bi-check-circle me-2"></i>@TempData["MensajeExito"]
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="sgio-alert danger mb-3">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["MensajeError"]
    </div>
}

<!-- Stats -->
<div class="stats-row mb-4">
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(62,100,255,.1);color:#3e64ff;">
            <i class="bi bi-people"></i>
        </div>
        <div>
            <p class="stat-label">Total Usuarios</p>
            <h3 class="stat-value">@total</h3>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(16,185,129,.1);color:#10b981;">
            <i class="bi bi-person-check"></i>
        </div>
        <div>
            <p class="stat-label">Activos</p>
            <h3 class="stat-value">@activos</h3>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(239,68,68,.1);color:#ef4444;">
            <i class="bi bi-person-x"></i>
        </div>
        <div>
            <p class="stat-label">Bloqueados</p>
            <h3 class="stat-value">@inactivos</h3>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(245,158,11,.1);color:#f59e0b;">
            <i class="bi bi-shield-check"></i>
        </div>
        <div>
            <p class="stat-label">Administradores</p>
            <h3 class="stat-value">@admins</h3>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(139,92,246,.1);color:#8b5cf6;">
            <i class="bi bi-diagram-3"></i>
        </div>
        <div>
            <p class="stat-label">Empleados</p>
            <h3 class="stat-value">@empleados</h3>
        </div>
    </div>
</div>

<!-- Tabla -->
<div class="table-card">
    <div class="table-responsive">
    <table id="usuariosTable" class="sgio-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Usuario</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                string rolBadge = usuario.Rol?.Nombre switch {
                    "Administrador" => "progress",
                    "Supervisor"    => "pending",
                    "Empleado"      => "complete",
                    _               => "inactive"
                };

                <tr>
                    <td class="text-muted" style="font-size:12px;" data-label="#">@usuario.IdUsuario</td>
                    <td data-label="Usuario">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:32px;height:32px;border-radius:50%;
                                        background:linear-gradient(135deg,#3e64ff20,#3e64ff40);
                                        color:#3e64ff;font-weight:700;font-size:12px;
                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                @(usuario.Nombre?.Substring(0,1).ToUpper() ?? "?")@(usuario.Apellido?.Substring(0,1).ToUpper() ?? "?")
                            </div>
                            <div>
                                <p class="mb-0 fw-500" style="font-size:14px;">@usuario.Nombre @usuario.Apellido</p>
                            </div>
                        </div>
                    </td>
                    <td class="text-muted" style="font-size:13px;" data-label="Correo">@usuario.Correo</td>
                    <td data-label="Rol">
                        <span class="badge-status @rolBadge">@(usuario.Rol?.Nombre ?? "—")</span>
                    </td>
                    <td data-label="Estado">
                        @if (usuario.Activo)
                        {
                            <span class="badge-status complete">Activo</span>
                        }
                        else
                        {
                            <span class="badge-status inactive">Bloqueado</span>
                        }
                    </td>
                    <td class="text-center" data-label="Acciones">
                        <div class="d-flex gap-1 justify-content-center">
                            <button type="button" class="btn btn-action edit cambiar-rol-btn"
                                    data-bs-toggle="modal" data-bs-target="#modalCambiarRol"
                                    data-usuario-id="@usuario.IdUsuario"
                                    data-usuario-nombre="@usuario.Nombre @usuario.Apellido"
                                    data-rol-actual="@usuario.IdRol"
                                    title="Cambiar rol">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (usuario.Activo)
                            {
                                <button type="button" class="btn btn-action delete bloquearID"
                                        data-bs-toggle="modal" data-bs-target="#bloquearModal"
                                        data-bs-id="@usuario.IdUsuario"
                                        title="Bloquear usuario">
                                    <i class="bi bi-lock-fill"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-action view bloquearID"
                                        data-bs-toggle="modal" data-bs-target="#bloquearModal"
                                        data-bs-id="@usuario.IdUsuario"
                                        title="Desbloquear usuario">
                                    <i class="bi bi-unlock-fill"></i>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

<!-- Modal Cambiar Estado -->
<div class="modal fade" id="bloquearModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cambiar Estado de Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("CambiarEstado", "Administrativo", FormMethod.Post))
            {
                <div class="modal-body">
                    <input type="hidden" id="IdUsuario" name="IdUsuario" value="" />
                    <p class="mb-0">¿Seguro que deseas cambiar el estado de este usuario?</p>
                    <p class="text-muted small mt-1 mb-0">El acceso al sistema se activará o bloqueará de inmediato.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Confirmar</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Cambiar Rol -->
<div class="modal fade" id="modalCambiarRol" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-gear me-2"></i>Cambiar Rol</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CambiarRol" asp-controller="Administrativo" method="post">
                <input type="hidden" name="id" id="cambiarRolUsuarioId" value="" />
                <div class="modal-body">
                    <p class="mb-3">Usuario: <strong id="cambiarRolUsuarioNombre"></strong></p>
                    <label class="form-label">Nuevo rol</label>
                    <select name="nuevoRolId" id="cambiarRolSelect" class="form-select" required>
                        @foreach (var rol in (List<ProyectoSGIOCore.Models.Rol>)ViewBag.Roles)
                        {
                            <option value="@rol.IdRol">@rol.Nombre</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
<script>
    $(document).ready(function () {
        $("#usuariosTable").DataTable({
            language: { url: "//cdn.datatables.net/plug-ins/2.1.8/i18n/es-MX.json" },
            columnDefs: [
                { orderable: false, targets: [5] }
            ],
            pageLength: 15,
            order: [[0, 'asc']]
        });
    });

    $(".bloquearID").click(function () {
        $("#IdUsuario").val($(this).attr('data-bs-id'));
    });

    $(".cambiar-rol-btn").click(function () {
        $("#cambiarRolUsuarioId").val($(this).data("usuario-id"));
        $("#cambiarRolUsuarioNombre").text($(this).data("usuario-nombre"));
        $("#cambiarRolSelect").val($(this).data("rol-actual"));
    });
</script>
}
