@model IEnumerable<ProyectoSGIOCore.Models.Proveedor>
@{
    ViewBag.Title = "Proveedores";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int total = Model.Count();
    int activos = Model.Count(p => p.Estado);
    int inactivos = Model.Count(p => !p.Estado);
}

@if (TempData["MensajeExito"] != null)
{
    <div class="sgio-alert success"><i class="bi bi-check-circle-fill"></i> @TempData["MensajeExito"]</div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="sgio-alert danger"><i class="bi bi-exclamation-circle-fill"></i> @TempData["MensajeError"]</div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-header-title"><i class="bi bi-truck me-2 text-primary"></i>Proveedores</h1>
        <p class="page-header-subtitle">Directorio de proveedores y su estado</p>
    </div>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="page-header-actions">
            <a asp-controller="Proveedores" asp-action="DescargarProveedoresHTML" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-file-earmark-code me-1"></i> HTML
            </a>
            <a asp-controller="Proveedores" asp-action="DescargarProveedoresCSV" class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> CSV
            </a>
            <a asp-controller="Proveedores" asp-action="RegistroProveedor" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Proveedor
            </a>
        </div>
    }
</div>

<!-- Stats -->
<div class="stats-row">
    <div class="stat-mini">
        <div class="stat-mini-icon blue"><i class="bi bi-truck"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">@total</div>
            <div class="stat-mini-label">Total proveedores</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon green"><i class="bi bi-check-circle"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">@activos</div>
            <div class="stat-mini-label">Activos</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon red"><i class="bi bi-x-circle"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">@inactivos</div>
            <div class="stat-mini-label">Inactivos</div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="table-card">
    <div class="table-responsive">
        <table id="proveedoresTable" class="sgio-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proveedor in Model)
                {
                    <tr>
                        <td data-label="ID"><span class="text-muted">#@proveedor.IdProveedor</span></td>
                        <td data-label="Nombre"><strong>@proveedor.Nombre</strong></td>
                        <td data-label="Correo">@proveedor.Correo</td>
                        <td data-label="Teléfono">@proveedor.Telefono</td>
                        <td class="text-muted" data-label="Dirección">@proveedor.Direccion</td>
                        <td class="text-center" data-label="Estado">
                            @if (proveedor.Estado)
                            {
                                <span class="badge-status active">Activo</span>
                            }
                            else
                            {
                                <span class="badge-status inactive">Inactivo</span>
                            }
                        </td>
                        <td class="text-center" data-label="Acciones">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <form asp-action="CambiarEstado" asp-controller="Proveedores" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@proveedor.IdProveedor" />
                                    <button type="submit" class="btn-action @(proveedor.Estado ? "toggle-on" : "toggle-off") me-1"
                                            title="@(proveedor.Estado ? "Inactivar" : "Activar")">
                                        <i class="bi @(proveedor.Estado ? "bi-toggle2-on" : "bi-toggle2-off")"></i>
                                    </button>
                                </form>
                                <a asp-action="EditarProveedor" asp-route-id="@proveedor.IdProveedor" class="btn-action edit me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn-action delete"
                                        data-bs-toggle="modal" data-bs-target="#confirmarEliminacionModal"
                                        data-id="@proveedor.IdProveedor" data-nombre="@proveedor.Nombre" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">Solo lectura</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Eliminar -->
@if (User.Identity.IsAuthenticated)
{
    <div class="modal fade" id="confirmarEliminacionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">¿Estás seguro de que deseas eliminar al proveedor <strong id="proveedorNombre"></strong>? Esta acción no se puede deshacer.</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="EliminarProveedorConfirmado" asp-controller="Proveedores" method="post">
                        <input type="hidden" name="id" id="proveedorIdEliminar" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        $(document).ready(function () {
            $("#proveedoresTable").DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/2.1.8/i18n/es-MX.json" },
                pageLength: 10
            });
            $('#confirmarEliminacionModal').on('show.bs.modal', function (event) {
                var btn = $(event.relatedTarget);
                $('#proveedorIdEliminar').val(btn.data('id'));
                $('#proveedorNombre').text(btn.data('nombre'));
            });
        });
    </script>
}
