@model IEnumerable<ProyectoSGIOCore.Models.FacturaProveedor>

@{
    ViewBag.Title = "VisualizarFacturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Facturas de Proveedores</h2>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success text-center alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger text-center alert-dismissible fade show" role="alert">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="text-end mb-3">
        <a asp-action="RegistroFactura" class="btn btn-primary">Registrar factura</a>
        <a asp-action="DescargarFacturasHTML" class="btn btn-danger">Descargar HTML</a>
    </div>

    <!-- Mostrar las métricas personalizadas -->
    <div class="row mb-4">
        <div class="col-md-4">
            <h5>Total de Facturas: @ViewBag.TotalFacturas.ToString("C")</h5>
        </div>
        <div class="col-md-4">
            <h5>Total de Impuestos: @ViewBag.TotalImpuestos.ToString("C")</h5>
        </div>
        <div class="col-md-4">
            <h5>Promedio de Factura: @ViewBag.PromedioFactura.ToString("C")</h5>
        </div>
    </div>

    <div class="table-responsive">
        <table id="facturasTable" class="table table-striped table-hover table-bordered table-custom">
            <thead class="table-primary">
                <tr>
                    <th class="text-center">ID</th>
                    <th class="text-center">Proveedor</th>
                    <th class="text-center">Número de Factura</th>
                    <th class="text-center">Fecha de Emisión</th>
                    <th class="text-center">Monto Total</th>
                    <th class="text-center">Descripción</th>
                    <th class="text-center">Impuesto</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var factura in Model)
                {
                    decimal impuesto = factura.MontoTotal * 0.16m;
                    <tr class="text-center">
                        <td>@factura.IdFactura</td>
                        <td>@(factura.Proveedor != null ? factura.Proveedor.Nombre : "Proveedor no encontrado")</td>
                        <td>@factura.NumeroFactura</td>
                        <td>@factura.FechaEmision.ToShortDateString()</td>
                        <td>@factura.MontoTotal</td>
                        <td>@factura.Descripcion</td>
                        <td>@impuesto.ToString("C")</td>
                        <td>
                            <a asp-action="EditarFactura" asp-route-id="@factura.IdFactura" class="btn btn-warning btn-sm me-1" title="Editar">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <button class="btn btn-danger btn-sm btn-eliminar-factura"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEliminarFactura"
                                    data-id="@factura.IdFactura"
                                    data-numero="@factura.NumeroFactura"
                                    title="Eliminar">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="modalEliminarFactura" tabindex="-1" aria-labelledby="modalEliminarFacturaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarFacturaLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que deseas eliminar la factura <strong><span id="numeroFacturaEliminar"></span></strong>? Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminarFactura" method="post" asp-action="EliminarFactura">
                    <input type="hidden" id="idFacturaEliminar" name="id" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#facturasTable").DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/2.1.8/i18n/es-MX.json"
                }
            });

            $(".btn-eliminar-factura").on("click", function () {
                $("#numeroFacturaEliminar").text($(this).data("numero"));
                $("#idFacturaEliminar").val($(this).data("id"));
            });
        });
    </script>
}