@model IEnumerable<ProyectoSGIOCore.Models.FacturaProveedor>
@using ProyectoSGIOCore.Models
@{
    ViewBag.Title = "Facturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal totalMonto   = Model.Sum(f => f.MontoTotal);
    decimal totalImpuesto = Model.Sum(f => f.MontoTotal * 0.16m);
    decimal promedio     = Model.Any() ? Model.Average(f => f.MontoTotal) : 0;
    int count = Model.Count();
    var adjuntos = (List<Adjunto>)(ViewBag.Adjuntos ?? new List<Adjunto>());
}

@if (TempData["MensajeExito"] != null)
{
    <div class="sgio-alert success"><i class="bi bi-check-circle-fill"></i> @TempData["MensajeExito"]</div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="sgio-alert danger"><i class="bi bi-exclamation-circle-fill"></i> @TempData["MensajeError"]</div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-header-title"><i class="bi bi-receipt me-2 text-primary"></i>Facturas de Proveedores</h1>
        <p class="page-header-subtitle">Registro y seguimiento de facturas emitidas</p>
    </div>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="page-header-actions">
            <a asp-action="DescargarFacturasHTML" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-file-earmark-code me-1"></i> HTML
            </a>
            <a asp-action="RegistroFactura" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Nueva Factura
            </a>
        </div>
    }
</div>

<!-- Stats -->
<div class="stats-row">
    <div class="stat-mini">
        <div class="stat-mini-icon blue"><i class="bi bi-receipt"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">@count</div>
            <div class="stat-mini-label">Total facturas</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon green"><i class="bi bi-currency-dollar"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">$@totalMonto.ToString("N0")</div>
            <div class="stat-mini-label">Monto total</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon orange"><i class="bi bi-percent"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">$@totalImpuesto.ToString("N0")</div>
            <div class="stat-mini-label">Impuestos (16%)</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon purple"><i class="bi bi-graph-up"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">$@promedio.ToString("N0")</div>
            <div class="stat-mini-label">Promedio factura</div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="table-card">
    <div class="table-responsive">
        <table id="facturasTable" class="sgio-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>N° Factura</th>
                    <th>Proveedor</th>
                    <th>Fecha Emisión</th>
                    <th class="text-center">Monto Total</th>
                    <th class="text-center">Impuesto</th>
                    <th>Descripción</th>
                    <th class="text-center">Adjuntos</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var factura in Model)
                {
                    decimal impuesto = factura.MontoTotal * 0.16m;
                    var adjuntosFactura = adjuntos.Where(a => a.EntidadId == factura.IdFactura).ToList();
                    <tr>
                        <td data-label="ID"><span class="text-muted">#@factura.IdFactura</span></td>
                        <td data-label="N° Factura"><strong>@factura.NumeroFactura</strong></td>
                        <td data-label="Proveedor">@(factura.Proveedor?.Nombre ?? "—")</td>
                        <td data-label="Fecha Emisión">@factura.FechaEmision.ToString("dd/MM/yyyy")</td>
                        <td class="text-center" data-label="Monto Total">$@factura.MontoTotal.ToString("N2")</td>
                        <td class="text-center" data-label="Impuesto">$@impuesto.ToString("N2")</td>
                        <td class="text-muted" data-label="Descripción">@(factura.Descripcion ?? "—")</td>
                        <td class="text-center" data-label="Adjuntos">
                            <button type="button" class="btn-action" title="Ver adjuntos" data-bs-toggle="modal" data-bs-target="#modalAdjuntos_@factura.IdFactura">
                                <i class="bi bi-paperclip"></i> @adjuntosFactura.Count
                            </button>
                        </td>
                        <td class="text-center" data-label="Acciones">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-action="EditarFactura" asp-route-id="@factura.IdFactura" class="btn-action edit me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn-action delete btn-eliminar-factura"
                                        data-bs-toggle="modal" data-bs-target="#modalEliminarFactura"
                                        data-id="@factura.IdFactura" data-numero="@factura.NumeroFactura" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">Solo lectura</span>
                            }
                        </td>
                    </tr>

                    <!-- Modal Adjuntos -->
                    <div class="modal fade" id="modalAdjuntos_@factura.IdFactura" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title"><i class="bi bi-paperclip me-2"></i>Adjuntos — @factura.NumeroFactura</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    @if (!adjuntosFactura.Any())
                                    {
                                        <p class="text-muted mb-3" style="font-size:13px;">Todavía no hay comprobantes adjuntos a esta factura.</p>
                                    }
                                    else
                                    {
                                        <ul class="list-group mb-3">
                                            @foreach (var adj in adjuntosFactura)
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-center" style="font-size:13px;">
                                                    <a href="@adj.UrlPublica" target="_blank" rel="noopener" class="text-decoration-none text-truncate" style="max-width:220px;">
                                                        <i class="bi bi-file-earmark-arrow-down me-1"></i>@adj.NombreArchivo
                                                    </a>
                                                    @if (User.Identity.IsAuthenticated)
                                                    {
                                                        <form asp-action="EliminarAdjuntoFactura" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este adjunto?');">
                                                            <input type="hidden" name="id" value="@adj.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <form asp-action="SubirAdjuntoFactura" method="post" enctype="multipart/form-data">
                                            <input type="hidden" name="facturaId" value="@factura.IdFactura" />
                                            <div class="input-group">
                                                <input type="file" name="archivo" class="form-control" accept=".pdf,.png,.jpg,.jpeg,.webp" required />
                                                <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>Subir</button>
                                            </div>
                                            <p class="text-muted mt-1 mb-0" style="font-size:11px;">PDF, PNG, JPG o WEBP · máximo 10 MB</p>
                                        </form>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Eliminar -->
@if (User.Identity.IsAuthenticated)
{
    <div class="modal fade" id="modalEliminarFactura" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">¿Estás seguro de que deseas eliminar la factura <strong><span id="numeroFacturaEliminar"></span></strong>? Esta acción no se puede deshacer.</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="EliminarFactura" method="post">
                        <input type="hidden" id="idFacturaEliminar" name="id" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        $(document).ready(function () {
            $("#facturasTable").DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/2.1.8/i18n/es-MX.json" },
                pageLength: 10,
                order: [[0, "desc"]]
            });
            $(".btn-eliminar-factura").on("click", function () {
                $("#numeroFacturaEliminar").text($(this).data("numero"));
                $("#idFacturaEliminar").val($(this).data("id"));
            });
        });
    </script>
}
