@model ProyectoSGIOCore.Models.FacturaProveedor
@{
    ViewBag.Title = "Editar Factura";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="form-container">
        <h2 class="text-center mb-4">Editar Factura</h2>

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger text-center alert-dismissible fade show" role="alert">
                @TempData["MensajeError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="EditarFactura" asp-controller="Facturas" method="post">
            <input type="hidden" asp-for="IdFactura" />
            <input type="hidden" asp-for="NumeroFactura" />

            <div class="mb-3">
                <label class="form-label">Número de Factura</label>
                <input type="text" class="form-control" value="@Model.NumeroFactura" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Proveedor</label>
                <select name="IdProveedor" asp-items="ViewBag.Proveedores" class="form-select" required>
                    <option value="">Seleccione un proveedor</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Fecha de Emisión</label>
                <input type="date" asp-for="FechaEmision" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Monto Total</label>
                <input type="number" asp-for="MontoTotal" class="form-control" min="0" step="0.01" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Guardar Cambios</button>
                <a asp-action="VisualizarFacturas" class="btn btn-secondary w-100">Cancelar</a>
            </div>
        </form>
    </div>
</div>
