@model IEnumerable<ProyectoSGIOCore.Models.CierreFinanciero>
@{
    ViewBag.Title = "Cierres Mensuales";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal totalIngresos = Model.Sum(c => c.TotalIngresos);
    decimal totalEgresos  = Model.Sum(c => c.TotalEgresos);
    decimal utilidadTotal = Model.Sum(c => c.Utilidad);
}

@if (TempData["MensajeExito"] != null)
{
    <div class="sgio-alert success"><i class="bi bi-check-circle-fill"></i> @TempData["MensajeExito"]</div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="sgio-alert danger"><i class="bi bi-exclamation-circle-fill"></i> @TempData["MensajeError"]</div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-header-title"><i class="bi bi-calendar3 me-2 text-primary"></i>Cierres Financieros Mensuales</h1>
        <p class="page-header-subtitle">Resumen consolidado por mes</p>
    </div>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="page-header-actions">
            <a asp-controller="CierresFinancieros" asp-action="RegistrarCierreMensual" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Registrar Cierre
            </a>
        </div>
    }
</div>

<!-- Stats -->
<div class="stats-row">
    <div class="stat-mini">
        <div class="stat-mini-icon blue"><i class="bi bi-calendar-check"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">@Model.Count()</div>
            <div class="stat-mini-label">Cierres registrados</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon green"><i class="bi bi-arrow-up-circle"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">$@totalIngresos.ToString("N0")</div>
            <div class="stat-mini-label">Total ingresos</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon red"><i class="bi bi-arrow-down-circle"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">$@totalEgresos.ToString("N0")</div>
            <div class="stat-mini-label">Total egresos</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon @(utilidadTotal >= 0 ? "green" : "red")">
            <i class="bi bi-graph-up-arrow"></i>
        </div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">$@utilidadTotal.ToString("N0")</div>
            <div class="stat-mini-label">Utilidad acumulada</div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="table-card">
    <div class="table-responsive">
        <table id="cierresTable" class="sgio-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Año</th>
                    <th>Mes</th>
                    <th>Fecha Cierre</th>
                    <th class="text-center">Ingresos</th>
                    <th class="text-center">Egresos</th>
                    <th class="text-center">Utilidad</th>
                    <th>Observaciones</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cierre in Model)
                {
                    string mes = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(cierre.Mes);
                    <tr>
                        <td><span class="text-muted">#@cierre.IdCierre</span></td>
                        <td><strong>@cierre.Anio</strong></td>
                        <td>@mes</td>
                        <td>@cierre.FechaCierre.ToString("dd/MM/yyyy")</td>
                        <td class="text-center text-success fw-600">$@cierre.TotalIngresos.ToString("N2")</td>
                        <td class="text-center text-danger fw-600">$@cierre.TotalEgresos.ToString("N2")</td>
                        <td class="text-center">
                            <strong class="@(cierre.Utilidad >= 0 ? "text-success" : "text-danger")">
                                $@cierre.Utilidad.ToString("N2")
                            </strong>
                        </td>
                        <td class="text-muted">@(cierre.Observaciones ?? "—")</td>
                        <td class="text-center">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <button class="btn-action delete btn-eliminar-cierre"
                                        data-bs-toggle="modal" data-bs-target="#modalEliminarCierre"
                                        data-id="@cierre.IdCierre"
                                        data-mes="@mes"
                                        data-anio="@cierre.Anio" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">Solo lectura</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (User.Identity.IsAuthenticated)
{
    <div class="modal fade" id="modalEliminarCierre" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">¿Estás seguro de que deseas eliminar el cierre de <strong><span id="mesAnioEliminar"></span></strong>?</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="EliminarCierre" asp-controller="CierresFinancieros" method="post">
                        <input type="hidden" id="idCierreEliminar" name="id" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        $(document).ready(function () {
            $("#cierresTable").DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/2.1.8/i18n/es-MX.json" },
                pageLength: 10
            });
            $(".btn-eliminar-cierre").on("click", function () {
                $("#mesAnioEliminar").text($(this).data("mes") + " " + $(this).data("anio"));
                $("#idCierreEliminar").val($(this).data("id"));
            });
        });
    </script>
}
