@model IEnumerable<ProyectoSGIOCore.Models.Empleado>
@{
    ViewData["Title"] = "Visualizar Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h2 class="text-center mb-4">Empleados registrados en el sistema</h2>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success text-center alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger text-center alert-dismissible fade show" role="alert">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="text-end mb-3">
        <a asp-controller="Empleado" asp-action="CrearEmpleado" class="btn btn-primary">Registrar nuevo empleado</a>
    </div>

    <div class="table-responsive">
        <table id="empleadosTable" class="table table-striped table-hover table-bordered table-custom">
            <thead class="table-primary">
                <tr>
                    <th class="text-center">ID</th>
                    <th class="text-center">Nombre</th>
                    <th class="text-center">Apellido</th>
                    <th class="text-center">Correo</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var empleado in Model)
                {
                    <tr class="text-center">
                        <td>@empleado.IdEmpleado</td>
                        <td>@empleado.Nombre</td>
                        <td>@empleado.Apellido</td>
                        <td>@empleado.Correo</td>
                        <td>
                            <!-- Botón de editar -->
                            <a asp-action="EditarEmpleado" asp-route-id="@empleado.IdEmpleado" class="btn btn-warning me-1" title="Editar">
                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <!-- Botón de eliminar con modal -->
                            <button class="btn btn-danger btn-eliminar"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEliminar"
                                    data-id="@empleado.IdEmpleado"
                                    data-nombre="@empleado.Nombre"
                                    data-apellido="@empleado.Apellido">
                                <i class="bi bi-trash-fill"></i>
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que deseas eliminar al empleado <strong><span id="nombreEmpleado"></span> <span id="apellidoEmpleado"></span></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminarEmpleado" method="post" asp-action="EliminarEmpleadoConfirmado">
                    <input type="hidden" id="idEmpleadoEliminar" name="id" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#empleadosTable").DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/2.1.8/i18n/es-MX.json"
                }
            });

            // Capturar el ID, nombre y apellido del empleado al abrir el modal
            $(".btn-eliminar").on("click", function () {
                let empleadoId = $(this).data("id");
                let nombreEmpleado = $(this).data("nombre");
                let apellidoEmpleado = $(this).data("apellido");

                // Actualizar el contenido del modal
                $("#nombreEmpleado").text(nombreEmpleado);
                $("#apellidoEmpleado").text(apellidoEmpleado);
                $("#idEmpleadoEliminar").val(empleadoId);
            });
        });
    </script>
}