@model IEnumerable<ProyectoSGIOCore.Models.Inventario>
@{
    ViewBag.Title = "Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int total = Model.Count();
    int enStock = Model.Count(p => p.Cantidad > 0);
    int sinStock = Model.Count(p => p.Cantidad == 0);
    decimal valorTotal = Model.Sum(p => p.Cantidad * p.PrecioUnidad);
}

<!-- Alerts -->
@if (TempData["MensajeExito"] != null)
{
    <div class="sgio-alert success"><i class="bi bi-check-circle-fill"></i> @TempData["MensajeExito"]</div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="sgio-alert danger"><i class="bi bi-exclamation-circle-fill"></i> @TempData["MensajeError"]</div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <h1 class="page-header-title"><i class="bi bi-boxes me-2 text-primary"></i>Inventario de Productos</h1>
        <p class="page-header-subtitle">Gestión de materiales y stock de la empresa</p>
    </div>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="page-header-actions">
            <a asp-action="DescargarInventarioHTML" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-file-earmark-code me-1"></i> HTML
            </a>
            <a asp-action="DescargarInventarioCSV" class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> CSV
            </a>
            <a asp-action="CrearInventario" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
            </a>
        </div>
    }
</div>

<!-- Stats -->
<div class="stats-row">
    <div class="stat-mini">
        <div class="stat-mini-icon blue"><i class="bi bi-boxes"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">@total</div>
            <div class="stat-mini-label">Total productos</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon green"><i class="bi bi-check-circle"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">@enStock</div>
            <div class="stat-mini-label">En stock</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon red"><i class="bi bi-x-circle"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">@sinStock</div>
            <div class="stat-mini-label">Sin stock</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon purple"><i class="bi bi-currency-dollar"></i></div>
        <div class="stat-mini-body">
            <div class="stat-mini-value">@valorTotal.ToString("N0")</div>
            <div class="stat-mini-label">Valor total</div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="table-card">
    <div class="table-responsive">
        <table id="inventarioTable" class="sgio-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-center">Precio Unitario</th>
                    <th class="text-center">Precio Total</th>
                    <th class="text-center">Stock</th>
                    <th>Info Adicional</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <td data-label="ID"><span class="text-muted">#@producto.ID</span></td>
                        <td data-label="Nombre"><strong>@producto.Nombre</strong></td>
                        <td data-label="Categoría">@producto.Categoria</td>
                        <td class="text-center" data-label="Cantidad">@producto.Cantidad</td>
                        <td class="text-center" data-label="Precio Unitario">$@producto.PrecioUnidad.ToString("N2")</td>
                        <td class="text-center" data-label="Precio Total">$@((producto.Cantidad * producto.PrecioUnidad).ToString("N2"))</td>
                        <td class="text-center" data-label="Stock">
                            @if (producto.Cantidad > 0)
                            {
                                <span class="badge-instock"><i class="bi bi-check2 me-1"></i>En stock</span>
                            }
                            else
                            {
                                <span class="badge-nostock"><i class="bi bi-x me-1"></i>Sin stock</span>
                            }
                        </td>
                        <td class="text-muted" data-label="Info Adicional">@(producto.InformacionAdicional ?? "—")</td>
                        <td class="text-center" data-label="Acciones">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-action="EditarInventario" asp-route-id="@producto.ID" class="btn-action edit me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn-action delete eliminarProducto"
                                        data-bs-toggle="modal" data-bs-target="#eliminarModal"
                                        data-bs-id="@producto.ID" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted small">Solo lectura</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Eliminar -->
@if (User.Identity.IsAuthenticated)
{
    <div class="modal fade" id="eliminarModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">¿Estás seguro de que deseas eliminar este producto del inventario? Esta acción no se puede deshacer.</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form id="eliminarForm" asp-action="EliminarInventario" method="post">
                        <input type="hidden" id="productoIdEliminar" name="id" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#inventarioTable").DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/2.1.8/i18n/es-MX.json" },
                pageLength: 10,
                order: [[0, "asc"]]
            });
            $(".eliminarProducto").on("click", function () {
                $("#productoIdEliminar").val($(this).data("bs-id"));
            });
        });
    </script>
}
