@using System.Security.Claims
@{
    // Un cliente logueado (rol "Usuario") solo ve su(s) propio(s) proyecto(s), y un
    // Empleado ve todos los proyectos pero nada de Facturas/Inventario/Proveedores/Empleados —
    // ambos casos quedan ocultos en el menú (además de bloqueados en el backend).
    bool esUsuarioCliente = User.Identity.IsAuthenticated && User.IsInRole("Usuario");
    bool esEmpleado = User.Identity.IsAuthenticated && User.IsInRole("Empleado");
    bool menuRestringido = esUsuarioCliente || esEmpleado;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SGIO — @(ViewBag.Title ?? ViewData["Title"] ?? "Sistema de Gestión")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800,900" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
<body>

<div class="wrapper">

    <!-- ======= SIDEBAR ======= -->
    <nav id="sidebar">

        <!-- Brand -->
        <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="bi bi-building"></i>
            </div>
            <div class="sidebar-brand-text">
                <strong>SGIO</strong>
                <small>Gestión de Obras</small>
            </div>
        </a>

        <!-- Navigation -->
        <ul class="sidebar-nav">

            @if (menuRestringido)
            {
                <li class="sidebar-section-label">Mi Espacio</li>
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proyecto" ? "active" : "")">
                    <a asp-controller="Proyecto" asp-action="Proyectos" class="sidebar-nav-link">
                        <i class="bi bi-house-gear-fill nav-icon"></i>
                        <span class="nav-label">@(esUsuarioCliente ? "Mis Proyectos" : "Proyectos")</span>
                    </a>
                </li>
            }
            else
            {

            @if (User.IsInRole("Administrador"))
            {
                <li class="sidebar-section-label">Administración</li>
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Administrativo" ? "active" : "")">
                    <a href="#" class="sidebar-nav-link has-submenu">
                        <i class="bi bi-people-fill nav-icon"></i>
                        <span class="nav-label">Usuarios</span>
                        <i class="bi bi-chevron-right nav-arrow"></i>
                    </a>
                    <ul class="sidebar-submenu">
                        <li><a asp-controller="Administrativo" asp-action="VisualizarUsuarios">Ver Usuarios</a></li>
                        <li><a asp-controller="Administrativo" asp-action="CrearUsuario">Crear Usuario</a></li>
                        <li><a asp-controller="Administrativo" asp-action="HistorialActividad">Historial de Actividad</a></li>
                    </ul>
                </li>
            }

            <li class="sidebar-section-label">Módulos</li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proyecto" && ViewContext.RouteData.Values["Action"]?.ToString() == "DashboardGeneral" ? "active" : "")">
                <a asp-controller="Proyecto" asp-action="DashboardGeneral" class="sidebar-nav-link">
                    <i class="bi bi-speedometer2 nav-icon"></i>
                    <span class="nav-label">Dashboard Ejecutivo</span>
                </a>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proyecto" && ViewContext.RouteData.Values["Action"]?.ToString() != "DashboardGeneral" ? "active" : "")">
                <a href="#" class="sidebar-nav-link has-submenu">
                    <i class="bi bi-house-gear-fill nav-icon"></i>
                    <span class="nav-label">Proyectos</span>
                    <i class="bi bi-chevron-right nav-arrow"></i>
                </a>
                <ul class="sidebar-submenu">
                    <li><a asp-controller="Proyecto" asp-action="Proyectos">Ver Proyectos</a></li>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor"))
                    {
                        <li><a asp-controller="Proyecto" asp-action="CrearProyecto">Crear Proyecto</a></li>
                    }
                </ul>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Facturas" || ViewContext.RouteData.Values["Controller"]?.ToString() == "CierresFinancieros" ? "active" : "")">
                <a href="#" class="sidebar-nav-link has-submenu">
                    <i class="bi bi-receipt nav-icon"></i>
                    <span class="nav-label">Facturas</span>
                    <i class="bi bi-chevron-right nav-arrow"></i>
                </a>
                <ul class="sidebar-submenu">
                    <li><a asp-controller="Facturas" asp-action="VisualizarFacturas">Ver Facturas</a></li>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor"))
                    {
                        <li><a asp-controller="Facturas" asp-action="RegistroFactura">Registrar Factura</a></li>
                    }
                </ul>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventario" ? "active" : "")">
                <a asp-controller="Inventario" asp-action="VisualizarInventario" class="sidebar-nav-link">
                    <i class="bi bi-boxes nav-icon"></i>
                    <span class="nav-label">Inventario</span>
                </a>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proveedores" ? "active" : "")">
                <a asp-controller="Proveedores" asp-action="VisualizarProveedores" class="sidebar-nav-link">
                    <i class="bi bi-truck nav-icon"></i>
                    <span class="nav-label">Proveedores</span>
                </a>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Empleado" ? "active" : "")">
                <a asp-controller="Empleado" asp-action="VisualizarEmpleados" class="sidebar-nav-link">
                    <i class="bi bi-person-badge-fill nav-icon"></i>
                    <span class="nav-label">Empleados</span>
                </a>
            </li>

            }

        </ul>

        <!-- Footer -->
        @if (User.Identity.IsAuthenticated)
        {
            var userName = User.Claims.Where(c => c.Type == ClaimTypes.Name).Select(c => c.Value).SingleOrDefault() ?? "Usuario";
            var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";
            var userRole = User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value).SingleOrDefault() ?? "";
            <div class="sidebar-footer">
                <div class="sidebar-footer-avatar">@userInitial</div>
                <div class="sidebar-footer-info">
                    <span>@userName</span>
                    <small>@userRole</small>
                </div>
            </div>
        }
        else
        {
            <div class="sidebar-copyright">
                SGIO &copy; @DateTime.Now.Year
            </div>
        }

    </nav>
    <!-- ======= END SIDEBAR ======= -->

    <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

    <!-- ======= MAIN CONTENT ======= -->
    <div id="content">

        <!-- Top Navbar -->
        <nav class="top-navbar">
            <div class="navbar-left">
                <button id="sidebarCollapse" title="Colapsar menú">
                    <i class="bi bi-list"></i>
                </button>
                @if (!esUsuarioCliente)
                {
                    <div class="navbar-search position-relative">
                        <i class="bi bi-search navbar-search-icon"></i>
                        <input type="text" id="busquedaGlobalInput" class="form-control navbar-search-input"
                               placeholder="@(esEmpleado ? "Buscar proyectos..." : "Buscar proyectos, facturas, proveedores...")" autocomplete="off" />
                        <div id="busquedaGlobalResultados" class="navbar-search-results d-none"></div>
                    </div>
                }
            </div>

            <div class="navbar-right">
                <a asp-controller="Home" asp-action="Index" class="nav-home-link">
                    <i class="bi bi-house"></i>
                    <span class="d-none d-md-inline">Inicio</span>
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    var navUserName = User.Claims.Where(c => c.Type == ClaimTypes.Name).Select(c => c.Value).SingleOrDefault() ?? "Usuario";
                    var navInitial = navUserName.Length > 0 ? navUserName[0].ToString().ToUpper() : "U";
                    <div class="dropdown">
                        <button class="nav-user-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="nav-user-avatar">@navInitial</div>
                            <span class="d-none d-md-inline">@navUserName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Acceso" asp-action="VerPerfil"><i class="bi bi-person me-2"></i>Ver perfil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Acceso" asp-action="CerrarSesion"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-controller="Acceso" asp-action="IniciarSesion">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                    </a>
                }
            </div>
        </nav>

        <!-- Page Content -->
        <div class="main-content">
            @RenderBody()
        </div>

    </div>
    <!-- ======= END MAIN CONTENT ======= -->

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
<script src="~/js/Menu.js"></script>
<script src="~/js/funciones.js"></script>

<style>
    .navbar-search { width: 340px; max-width: 40vw; margin-left: 16px; }
    .navbar-search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 14px; pointer-events: none; }
    .navbar-search-input { padding-left: 34px; font-size: 13px; border-radius: 8px; height: 38px; }
    .navbar-search-results {
        position: absolute; top: calc(100% + 6px); left: 0; right: 0;
        background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12); max-height: 400px; overflow-y: auto; z-index: 1050;
    }
    .navbar-search-group-label { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #94a3b8; padding: 8px 14px 4px; }
    .navbar-search-item { display: flex; align-items: center; gap: 10px; padding: 8px 14px; font-size: 13px; color: #1e293b; text-decoration: none; }
    .navbar-search-item:hover { background: #f8fafc; }
    .navbar-search-item-sub { font-size: 11px; color: #94a3b8; }
    .navbar-search-empty { padding: 16px; text-align: center; color: #94a3b8; font-size: 13px; }
    @@media (max-width: 768px) {
        .navbar-search { display: none; }
    }
</style>
<script>
    (function () {
        var input = document.getElementById('busquedaGlobalInput');
        var panel = document.getElementById('busquedaGlobalResultados');
        if (!input || !panel) return;

        var timeoutId = null;

        function escapeHtml(str) {
            var div = document.createElement('div');
            div.textContent = str == null ? '' : String(str);
            return div.innerHTML;
        }

        function iconoPara(tipo) {
            if (tipo === 'Proyecto') return 'bi-kanban';
            if (tipo === 'Factura') return 'bi-receipt';
            return 'bi-truck';
        }

        function render(data) {
            var grupos = [
                { label: 'Proyectos', items: data.proyectos || [] },
                { label: 'Facturas', items: data.facturas || [] },
                { label: 'Proveedores', items: data.proveedores || [] }
            ];
            var totalItems = grupos.reduce(function (acc, g) { return acc + g.items.length; }, 0);

            if (totalItems === 0) {
                panel.innerHTML = '<div class="navbar-search-empty">Sin resultados</div>';
                panel.classList.remove('d-none');
                return;
            }

            var html = '';
            grupos.forEach(function (g) {
                if (!g.items.length) return;
                html += '<div class="navbar-search-group-label">' + escapeHtml(g.label) + '</div>';
                g.items.forEach(function (item) {
                    html += '<a class="navbar-search-item" href="' + item.url + '">' +
                        '<i class="bi ' + iconoPara(item.tipo) + ' text-primary"></i>' +
                        '<div><div>' + escapeHtml(item.texto) + '</div>' +
                        (item.subtexto ? '<div class="navbar-search-item-sub">' + escapeHtml(item.subtexto) + '</div>' : '') +
                        '</div></a>';
                });
            });
            panel.innerHTML = html;
            panel.classList.remove('d-none');
        }

        input.addEventListener('input', function () {
            var q = this.value.trim();
            clearTimeout(timeoutId);
            if (q.length < 2) {
                panel.classList.add('d-none');
                return;
            }
            timeoutId = setTimeout(function () {
                fetch('/Busqueda/Global?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(render)
                    .catch(function () { panel.classList.add('d-none'); });
            }, 250);
        });

        input.addEventListener('focus', function () {
            if (input.value.trim().length >= 2 && panel.innerHTML) {
                panel.classList.remove('d-none');
            }
        });

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.navbar-search')) {
                panel.classList.add('d-none');
            }
        });
    })();
</script>

@RenderSection("scripts", required: false)
</body>
</html>
