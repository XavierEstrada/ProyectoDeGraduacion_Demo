@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SGIO — @(ViewBag.Title ?? ViewData["Title"] ?? "Sistema de Gestión")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800,900" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
<body>

<div class="wrapper">

    <!-- ======= SIDEBAR ======= -->
    <nav id="sidebar">

        <!-- Brand -->
        <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="bi bi-building"></i>
            </div>
            <div class="sidebar-brand-text">
                <strong>SGIO</strong>
                <small>Gestión de Obras</small>
            </div>
        </a>

        <!-- Navigation -->
        <ul class="sidebar-nav">

            @if (User.IsInRole("Administrador"))
            {
                <li class="sidebar-section-label">Administración</li>
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Administrativo" ? "active" : "")">
                    <a href="#" class="sidebar-nav-link has-submenu">
                        <i class="bi bi-people-fill nav-icon"></i>
                        <span class="nav-label">Usuarios</span>
                        <i class="bi bi-chevron-right nav-arrow"></i>
                    </a>
                    <ul class="sidebar-submenu">
                        <li><a asp-controller="Administrativo" asp-action="VisualizarUsuarios">Ver Usuarios</a></li>
                        <li><a asp-controller="Administrativo" asp-action="CrearUsuario">Crear Usuario</a></li>
                    </ul>
                </li>
            }

            <li class="sidebar-section-label">Módulos</li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proyecto" ? "active" : "")">
                <a href="#" class="sidebar-nav-link has-submenu">
                    <i class="bi bi-house-gear-fill nav-icon"></i>
                    <span class="nav-label">Proyectos</span>
                    <i class="bi bi-chevron-right nav-arrow"></i>
                </a>
                <ul class="sidebar-submenu">
                    <li><a asp-controller="Proyecto" asp-action="Proyectos">Ver Proyectos</a></li>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor"))
                    {
                        <li><a asp-controller="Proyecto" asp-action="CrearProyecto">Crear Proyecto</a></li>
                    }
                </ul>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Facturas" || ViewContext.RouteData.Values["Controller"]?.ToString() == "CierresFinancieros" ? "active" : "")">
                <a href="#" class="sidebar-nav-link has-submenu">
                    <i class="bi bi-receipt nav-icon"></i>
                    <span class="nav-label">Facturas</span>
                    <i class="bi bi-chevron-right nav-arrow"></i>
                </a>
                <ul class="sidebar-submenu">
                    <li><a asp-controller="Facturas" asp-action="VisualizarFacturas">Ver Facturas</a></li>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor"))
                    {
                        <li><a asp-controller="Facturas" asp-action="RegistroFactura">Registrar Factura</a></li>
                    }
                </ul>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventario" ? "active" : "")">
                <a asp-controller="Inventario" asp-action="VisualizarInventario" class="sidebar-nav-link">
                    <i class="bi bi-boxes nav-icon"></i>
                    <span class="nav-label">Inventario</span>
                </a>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proveedores" ? "active" : "")">
                <a asp-controller="Proveedores" asp-action="VisualizarProveedores" class="sidebar-nav-link">
                    <i class="bi bi-truck nav-icon"></i>
                    <span class="nav-label">Proveedores</span>
                </a>
            </li>

            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Empleado" ? "active" : "")">
                <a asp-controller="Empleado" asp-action="VisualizarEmpleados" class="sidebar-nav-link">
                    <i class="bi bi-person-badge-fill nav-icon"></i>
                    <span class="nav-label">Empleados</span>
                </a>
            </li>

        </ul>

        <!-- Footer -->
        @if (User.Identity.IsAuthenticated)
        {
            var userName = User.Claims.Where(c => c.Type == ClaimTypes.Name).Select(c => c.Value).SingleOrDefault() ?? "Usuario";
            var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";
            var userRole = User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value).SingleOrDefault() ?? "";
            <div class="sidebar-footer">
                <div class="sidebar-footer-avatar">@userInitial</div>
                <div class="sidebar-footer-info">
                    <span>@userName</span>
                    <small>@userRole</small>
                </div>
            </div>
        }
        else
        {
            <div class="sidebar-copyright">
                SGIO &copy; @DateTime.Now.Year
            </div>
        }

    </nav>
    <!-- ======= END SIDEBAR ======= -->

    <!-- ======= MAIN CONTENT ======= -->
    <div id="content">

        <!-- Top Navbar -->
        <nav class="top-navbar">
            <div class="navbar-left">
                <button id="sidebarCollapse" title="Colapsar menú">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <div class="navbar-right">
                <a asp-controller="Home" asp-action="Index" class="nav-home-link">
                    <i class="bi bi-house"></i>
                    <span class="d-none d-md-inline">Inicio</span>
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    var navUserName = User.Claims.Where(c => c.Type == ClaimTypes.Name).Select(c => c.Value).SingleOrDefault() ?? "Usuario";
                    var navInitial = navUserName.Length > 0 ? navUserName[0].ToString().ToUpper() : "U";
                    <div class="dropdown">
                        <button class="nav-user-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="nav-user-avatar">@navInitial</div>
                            <span class="d-none d-md-inline">@navUserName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Acceso" asp-action="VerPerfil"><i class="bi bi-person me-2"></i>Ver perfil</a></li>
                            <li><a class="dropdown-item" asp-controller="Acceso" asp-action="ActivarTwoFA"><i class="bi bi-shield-lock me-2"></i>Autenticación 2FA</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Acceso" asp-action="CerrarSesion"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-controller="Acceso" asp-action="IniciarSesion">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                    </a>
                }
            </div>
        </nav>

        <!-- Page Content -->
        <div class="main-content">
            @RenderBody()
        </div>

    </div>
    <!-- ======= END MAIN CONTENT ======= -->

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
<script src="~/js/menu.js"></script>
<script src="~/js/funciones.js"></script>

@RenderSection("scripts", required: false)
</body>
</html>
