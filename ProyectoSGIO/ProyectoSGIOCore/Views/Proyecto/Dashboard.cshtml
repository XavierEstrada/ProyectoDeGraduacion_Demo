@model ProyectoSGIOCore.Models.Proyecto
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Dashboard del Proyecto";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hitoDataJson   = (string)ViewBag.HitoDataJson;
    var tareaDataJson  = (string)ViewBag.TareaDataJson;
    var faseDataJson   = (string)ViewBag.FaseDataJson;
    var presupuestoPorMesJson = (string)ViewBag.PresupuestoPorMesJson;
    var gastoRealPorMesJson   = (string)ViewBag.GastoRealPorMesJson;
    int progresoGeneral = (int)ViewBag.ProgresoGeneral;
    decimal costoTotal  = (decimal)ViewBag.CostoTotal;

    int totalTareas = Model.Fases.SelectMany(f => f.Tareas).Count();
    int tareasOk    = Model.Fases.SelectMany(f => f.Tareas).Count(t => t.Completada);
    int totalHitos  = Model.Hitos.Count;
    int hitosCompletos = Model.Hitos.Count(h => h.estado == 1 || h.estado == 4);

    string hitoTimelineClase(int estado) => estado switch {
        1 => "complete", 2 => "pending", 3 => "progress", 4 => "complete", 5 => "inactive", _ => "pending"
    };
    string hitoTimelineLabel(int estado) => estado switch {
        1 => "Completo", 2 => "Pendiente", 3 => "En Progreso", 4 => "Aprobado", 5 => "Rechazado", _ => "—"
    };
}

<style>
    .hito-timeline {
        position: relative; padding-left: 26px;
        max-height: 300px; overflow-y: auto; padding-right: 6px;
    }
    .hito-timeline::before {
        content: ''; position: absolute; left: 8px; top: 4px; bottom: 4px; width: 2px; background: #e2e8f0;
    }
    .hito-timeline-item { position: relative; padding-bottom: 18px; }
    .hito-timeline-item:last-child { padding-bottom: 0; }
    .hito-timeline-dot {
        position: absolute; left: -26px; top: 3px; width: 14px; height: 14px; border-radius: 50%;
        border: 2px solid #fff; box-shadow: 0 0 0 2px currentColor;
    }
    .hito-timeline-dot.complete { background: #10b981; color: #10b981; }
    .hito-timeline-dot.progress { background: #3e64ff; color: #3e64ff; }
    .hito-timeline-dot.pending  { background: #f59e0b; color: #f59e0b; }
    .hito-timeline-dot.inactive { background: #94a3b8; color: #94a3b8; }
</style>

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">@Model.Nombre</h1>
        <p class="page-subtitle">Dashboard · Creado el @Model.FechaCreacion.ToString("dd/MM/yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportarDashboardPDF" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-file-earmark-pdf me-1"></i>Exportar PDF
        </a>
        @if (!User.IsInRole("Usuario"))
        {
            <a asp-action="GestionarProyecto" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-gear me-1"></i>Gestionar
            </a>
        }
        <a asp-action="Proyectos" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<!-- Stat cards -->
<div class="stats-row mb-4">
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(62,100,255,.1);color:#3e64ff;">
            <i class="bi bi-bar-chart-line"></i>
        </div>
        <div>
            <p class="stat-label">Progreso General</p>
            <h3 class="stat-value">@progresoGeneral%</h3>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(16,185,129,.1);color:#10b981;">
            <i class="bi bi-check2-circle"></i>
        </div>
        <div>
            <p class="stat-label">Tareas Completadas</p>
            <h3 class="stat-value">@tareasOk <small class="text-muted fs-6">/ @totalTareas</small></h3>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(245,158,11,.1);color:#f59e0b;">
            <i class="bi bi-flag"></i>
        </div>
        <div>
            <p class="stat-label">Hitos Alcanzados</p>
            <h3 class="stat-value">@hitosCompletos <small class="text-muted fs-6">/ @totalHitos</small></h3>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(139,92,246,.1);color:#8b5cf6;">
            <i class="bi bi-layers"></i>
        </div>
        <div>
            <p class="stat-label">Fases</p>
            <h3 class="stat-value">@Model.Fases.Count</h3>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(239,68,68,.1);color:#ef4444;">
            <i class="bi bi-cash-stack"></i>
        </div>
        <div>
            <p class="stat-label">Costo Total</p>
            <h3 class="stat-value" style="font-size:1.1rem;">$@costoTotal.ToString("N2")</h3>
        </div>
    </div>
</div>

<!-- Progreso general bar -->
<div class="table-card mb-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-600" style="font-size:14px;">Progreso General del Proyecto</span>
        <span class="fw-700 text-primary">@progresoGeneral%</span>
    </div>
    <div class="progress" style="height:12px;border-radius:6px;">
        <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated"
             style="width:@progresoGeneral%;border-radius:6px;" role="progressbar"
             aria-valuenow="@progresoGeneral" aria-valuemin="0" aria-valuemax="100">
        </div>
    </div>
    <p class="text-muted mb-0 mt-2" style="font-size:13px;">@tareasOk de @totalTareas tareas completadas</p>
</div>

<!-- Charts -->
<div class="row g-4 mb-4">
    <!-- Gráfico Hitos -->
    <div class="col-12 col-lg-6">
        <div class="table-card p-4 h-100">
            <h6 class="mb-3 fw-600" style="font-size:13px;">Hitos por Estado</h6>
            <div style="position:relative;height:220px;">
                <canvas id="hitoChart"></canvas>
            </div>
        </div>
    </div>
    <!-- Gráfico Tareas -->
    <div class="col-12 col-lg-6">
        <div class="table-card p-4 h-100">
            <h6 class="mb-3 fw-600" style="font-size:13px;">Tareas por Estado</h6>
            <div style="position:relative;height:220px;">
                <canvas id="tareaChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Costo por fase -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="table-card p-4">
            <h6 class="mb-3 fw-600" style="font-size:13px;">Costo por Fase</h6>
            <div style="position:relative;height:@(Math.Max(160, Model.Fases.Count * 46))px;">
                <canvas id="costoFaseChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Cronograma por fase -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="table-card p-4">
            <h6 class="mb-3 fw-600" style="font-size:13px;">Cronograma por Fase</h6>
            <div style="position:relative;height:@(Math.Max(120, Model.Fases.Count * 42))px;">
                <canvas id="ganttChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Línea de tiempo de hitos + Flujo de caja proyectado -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-6">
        <div class="table-card p-4 h-100">
            <h6 class="mb-3 fw-600" style="font-size:13px;">Línea de Tiempo de Hitos</h6>
            @if (!Model.Hitos.Any())
            {
                <p class="text-muted mb-0" style="font-size:13px;">No hay hitos registrados para este proyecto.</p>
            }
            else
            {
                <div class="hito-timeline">
                    @foreach (var hito in Model.Hitos.OrderBy(h => h.Fecha))
                    {
                        <div class="hito-timeline-item">
                            <div class="hito-timeline-dot @hitoTimelineClase(hito.estado)"></div>
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <strong style="font-size:13px;">@hito.Descripcion</strong>
                                <span class="badge-status @hitoTimelineClase(hito.estado)" style="flex-shrink:0;">@hitoTimelineLabel(hito.estado)</span>
                            </div>
                            <p class="text-muted mb-0" style="font-size:12px;">
                                @hito.Fecha.ToString("dd/MM/yyyy") · @(hito.Usuario != null ? $"{hito.Usuario.Nombre} {hito.Usuario.Apellido}" : "Sin asignar")
                            </p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="table-card p-4 h-100">
            <h6 class="mb-3 fw-600" style="font-size:13px;">Flujo de Caja Proyectado</h6>
            <div style="position:relative;height:260px;">
                <canvas id="flujoCajaChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Detalle de fases -->
<div class="table-card mb-4">
    <div class="p-4 border-bottom">
        <h6 class="mb-0 fw-600" style="font-size:13px;">Detalle de Fases</h6>
    </div>
    <div class="table-responsive">
    <table class="sgio-table mb-0">
        <thead>
            <tr>
                <th>Fase</th>
                <th>Tareas</th>
                <th>Completadas</th>
                <th>Costo</th>
                <th>Progreso</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fase in Model.Fases)
            {
                int ft = fase.Tareas.Count;
                int fc = fase.Tareas.Count(t => t.Completada);
                int fp = ft == 0 ? 0 : fc * 100 / ft;
                <tr>
                    <td class="fw-500">@fase.Nombre</td>
                    <td>@ft</td>
                    <td>@fc</td>
                    <td>$@fase.CostoTotal.ToString("N2")</td>
                    <td style="min-width:120px;">
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="height:6px;border-radius:3px;">
                                <div class="progress-bar @(fp == 100 ? "bg-success" : "bg-primary")"
                                     style="width:@fp%;border-radius:3px;"></div>
                            </div>
                            <span style="font-size:12px;color:#64748b;min-width:32px;">@fp%</span>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const hitoData  = JSON.parse('@Html.Raw(hitoDataJson ?? "[]")');
    const tareaData = JSON.parse('@Html.Raw(tareaDataJson ?? "[]")');
    const faseData  = JSON.parse('@Html.Raw(faseDataJson ?? "[]")');
    const presupuestoPorMes = JSON.parse('@Html.Raw(presupuestoPorMesJson ?? "[]")');
    const gastoRealPorMes   = JSON.parse('@Html.Raw(gastoRealPorMesJson ?? "[]")');

    const palette = {
        blue:   { bg: 'rgba(62,100,255,.2)',    border: '#3e64ff' },
        green:  { bg: 'rgba(16,185,129,.2)',    border: '#10b981' },
        amber:  { bg: 'rgba(245,158,11,.2)',    border: '#f59e0b' },
        red:    { bg: 'rgba(239,68,68,.2)',     border: '#ef4444' },
        purple: { bg: 'rgba(139,92,246,.2)',    border: '#8b5cf6' },
    };
    const colors = [palette.blue, palette.green, palette.amber, palette.red, palette.purple];

    // Plugin: texto centrado en las dosas (total + subtítulo)
    const centerTextPlugin = {
        id: 'centerText',
        afterDraw(chart) {
            const opts = chart.config.options.plugins.centerText;
            if (!opts) return;
            const { ctx, chartArea: { left, right, top, bottom } } = chart;
            const x = (left + right) / 2;
            const y = (top + bottom) / 2;
            ctx.save();
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillStyle = '#1e293b';
            ctx.font = '700 22px Poppins, Arial, sans-serif';
            ctx.fillText(opts.total, x, y - 10);
            ctx.fillStyle = '#64748b';
            ctx.font = '500 11px Poppins, Arial, sans-serif';
            ctx.fillText(opts.subtitle, x, y + 12);
            ctx.restore();
        }
    };

    function makeDonut(ctx, labels, counts, colorSet, subtitle) {
        const total = counts.reduce((a, b) => a + b, 0);
        return new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels,
                datasets: [{
                    data: counts,
                    backgroundColor: colorSet.map(c => c.bg),
                    borderColor: colorSet.map(c => c.border),
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                animation: { animateRotate: true, duration: 700 },
                plugins: {
                    legend: { position: 'bottom', labels: { font: { size: 11 }, padding: 12, usePointStyle: true } },
                    tooltip: {
                        callbacks: {
                            label(item) {
                                const pct = total ? Math.round((item.parsed / total) * 100) : 0;
                                return ` ${item.label}: ${item.parsed} (${pct}%)`;
                            }
                        }
                    },
                    centerText: { total, subtitle }
                }
            },
            plugins: [centerTextPlugin]
        });
    }

    // Hitos chart
    if (hitoData.length) {
        makeDonut(
            document.getElementById('hitoChart').getContext('2d'),
            hitoData.map(d => d.Nombre || 'Sin estado'),
            hitoData.map(d => d.Count),
            hitoData.map((_, i) => colors[i % colors.length]),
            'hitos'
        );
    }

    // Tareas chart (Pendiente / En Progreso / Completada)
    function colorParaEstadoTarea(nombre) {
        if (nombre === 'Completada') return palette.green;
        if (nombre === 'En Progreso') return palette.blue;
        return palette.amber;
    }

    if (tareaData.length) {
        makeDonut(
            document.getElementById('tareaChart').getContext('2d'),
            tareaData.map(d => d.Nombre),
            tareaData.map(d => d.Count),
            tareaData.map(d => colorParaEstadoTarea(d.Nombre)),
            'tareas'
        );
    }

    // Costo por fase (barras horizontales)
    if (faseData.length) {
        new Chart(document.getElementById('costoFaseChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: faseData.map(f => f.Nombre),
                datasets: [{
                    data: faseData.map(f => f.CostoTotal),
                    backgroundColor: faseData.map((_, i) => colors[i % colors.length].bg),
                    borderColor: faseData.map((_, i) => colors[i % colors.length].border),
                    borderWidth: 2,
                    borderRadius: 6,
                    maxBarThickness: 28
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 700 },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label(item) {
                                return ' $' + item.parsed.x.toLocaleString('en-US', { minimumFractionDigits: 2 });
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            callback: v => '$' + Number(v).toLocaleString('en-US')
                        },
                        grid: { color: 'rgba(0,0,0,.05)' }
                    },
                    y: { grid: { display: false } }
                }
            }
        });
    }

    // Cronograma por fase (Gantt con barras flotantes)
    // Nota: se usa una escala 'linear' con el rango calculado desde los datos reales
    // (no 'time') porque Chart.js no parsea bien pares [inicio, fin] en una escala de tiempo
    // dentro de un bar chart de índice invertido — terminaba mostrando 1970 (época Unix) como origen.
    const ganttFases = faseData.filter(f => f.FechaInicio && f.FechaFin);
    if (ganttFases.length) {
        const DIA_MS = 24 * 60 * 60 * 1000;
        const inicios = ganttFases.map(f => new Date(f.FechaInicio).getTime());
        const fines = ganttFases.map(f => new Date(f.FechaFin).getTime());
        const minFecha = Math.min(...inicios) - (7 * DIA_MS);
        const maxFecha = Math.max(...fines) + (7 * DIA_MS);

        new Chart(document.getElementById('ganttChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: ganttFases.map(f => f.Nombre),
                datasets: [{
                    data: ganttFases.map(f => [new Date(f.FechaInicio).getTime(), new Date(f.FechaFin).getTime()]),
                    backgroundColor: ganttFases.map((f, i) => f.PorcentajeCompletadas === 100 ? palette.green.bg : colors[i % colors.length].bg),
                    borderColor: ganttFases.map((f, i) => f.PorcentajeCompletadas === 100 ? palette.green.border : colors[i % colors.length].border),
                    borderWidth: 2,
                    borderRadius: 6,
                    barThickness: 22
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 700 },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label(item) {
                                const f = ganttFases[item.dataIndex];
                                const ini = new Date(f.FechaInicio).toLocaleDateString('es-CR');
                                const fin = new Date(f.FechaFin).toLocaleDateString('es-CR');
                                return ` ${ini} → ${fin}  ·  ${f.PorcentajeCompletadas}% completado`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        type: 'linear',
                        min: minFecha,
                        max: maxFecha,
                        ticks: {
                            callback: v => new Date(v).toLocaleDateString('es-CR', { month: 'short', year: 'numeric' })
                        },
                        grid: { color: 'rgba(0,0,0,.05)' }
                    },
                    y: { grid: { display: false } }
                }
            }
        });
    }

    // Flujo de caja proyectado: presupuesto (todas las tareas) vs. gasto real (tareas completadas)
    if (presupuestoPorMes.length || gastoRealPorMes.length) {
        const claveMes = d => `${d.Year}-${String(d.Month).padStart(2, '0')}`;
        const etiquetaMes = d => new Date(d.Year, d.Month - 1, 1).toLocaleDateString('es-CR', { month: 'short', year: 'numeric' });

        const claves = Array.from(new Set([...presupuestoPorMes.map(claveMes), ...gastoRealPorMes.map(claveMes)])).sort();
        const mapaPresupuesto = new Map(presupuestoPorMes.map(d => [claveMes(d), d.Monto]));
        const mapaGasto = new Map(gastoRealPorMes.map(d => [claveMes(d), d.Monto]));
        const mapaEtiqueta = new Map([...presupuestoPorMes, ...gastoRealPorMes].map(d => [claveMes(d), etiquetaMes(d)]));

        new Chart(document.getElementById('flujoCajaChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: claves.map(k => mapaEtiqueta.get(k)),
                datasets: [
                    {
                        label: 'Presupuesto',
                        data: claves.map(k => mapaPresupuesto.get(k) || 0),
                        backgroundColor: palette.blue.bg,
                        borderColor: palette.blue.border,
                        borderWidth: 2,
                        borderRadius: 4
                    },
                    {
                        label: 'Gasto Real',
                        data: claves.map(k => mapaGasto.get(k) || 0),
                        backgroundColor: palette.green.bg,
                        borderColor: palette.green.border,
                        borderWidth: 2,
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 700 },
                plugins: {
                    legend: { position: 'bottom', labels: { font: { size: 11 }, usePointStyle: true } },
                    tooltip: {
                        callbacks: {
                            label(item) {
                                return ` ${item.dataset.label}: $${item.parsed.y.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        ticks: { callback: v => '$' + Number(v).toLocaleString('en-US') },
                        grid: { color: 'rgba(0,0,0,.05)' }
                    }
                }
            }
        });
    }
</script>
}
