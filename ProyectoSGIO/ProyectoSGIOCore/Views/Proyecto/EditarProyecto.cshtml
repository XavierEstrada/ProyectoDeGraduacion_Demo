@model ProyectoSGIOCore.Models.Proyecto
@{
    ViewBag.Title = "Editar Proyecto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Editar Proyecto</h1>
        <p class="page-subtitle">Modifica el nombre o el estado del proyecto</p>
    </div>
    <a asp-action="Proyectos" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

@if (TempData["MensajeError"] != null)
{
    <div class="sgio-alert danger mb-3">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["MensajeError"]
    </div>
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="table-card">
            <div class="p-4">
                <form asp-action="EditarProyecto" asp-controller="Proyecto" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FechaCreacion" />

                    <div class="mb-4">
                        <label class="form-label fw-500">Nombre del Proyecto <span class="text-danger">*</span></label>
                        <input type="text" asp-for="Nombre" class="form-control" placeholder="Nombre del proyecto" required />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-500">Estado</label>
                        @Html.DropDownListFor(
                            model => model.Estado,
                            new SelectList(Enum.GetValues(typeof(ProyectoSGIOCore.Models.EstadoProyecto))),
                            new { @class = "form-select" })
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-3">
                        <a asp-action="Proyectos" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
