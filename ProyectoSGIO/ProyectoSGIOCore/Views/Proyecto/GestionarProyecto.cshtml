@model ProyectoSGIOCore.Models.Proyecto
@{
    ViewData["Title"] = "Gestionar Proyecto";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string estadoBadge(ProyectoSGIOCore.Models.EstadoProyecto e) => e switch {
        ProyectoSGIOCore.Models.EstadoProyecto.Completado  => "complete",
        ProyectoSGIOCore.Models.EstadoProyecto.Progreso    => "progress",
        ProyectoSGIOCore.Models.EstadoProyecto.Planificacion => "pending",
        _                                                   => "inactive"
    };

    int totalTareas = Model.Fases.SelectMany(f => f.Tareas).Count();
    int tareasOk    = Model.Fases.SelectMany(f => f.Tareas).Count(t => t.Completada);
    int progreso    = totalTareas == 0 ? 0 : tareasOk * 100 / totalTareas;
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">@Model.Nombre</h1>
        <p class="page-subtitle">Creado el @Model.FechaCreacion.ToString("dd/MM/yyyy") &nbsp;·&nbsp; <span class="badge-status @estadoBadge(Model.Estado)">@Model.Estado</span></p>
    </div>
    <a asp-action="Proyectos" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<!-- Alertas -->
@if (TempData["MensajeExito"] != null)
{
    <div class="sgio-alert success mb-3">
        <i class="bi bi-check-circle me-2"></i>@TempData["MensajeExito"]
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="sgio-alert danger mb-3">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["MensajeError"]
    </div>
}
<div id="alertAjax" style="display:none;" class="sgio-alert success mb-3">
    <i class="bi bi-check-circle me-2"></i><span id="alertAjaxMsg"></span>
</div>

<!-- Progreso + Estado -->
<div class="stats-row mb-4">
    <div class="stat-mini" style="flex:2;min-width:200px;">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span style="font-size:12px;font-weight:600;color:#64748b;">PROGRESO GENERAL</span>
            <span class="fw-700 text-primary">@progreso%</span>
        </div>
        <div class="progress" style="height:8px;border-radius:4px;">
            <div class="progress-bar bg-primary" style="width:@progreso%;border-radius:4px;"></div>
        </div>
        <p class="mt-1 mb-0" style="font-size:12px;color:#94a3b8;">@tareasOk de @totalTareas tareas completadas</p>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(62,100,255,.1);color:#3e64ff;"><i class="bi bi-layers"></i></div>
        <div><p class="stat-label">Fases</p><h3 class="stat-value">@Model.Fases.Count</h3></div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(16,185,129,.1);color:#10b981;"><i class="bi bi-check2-circle"></i></div>
        <div><p class="stat-label">Tareas Completadas</p><h3 class="stat-value">@tareasOk</h3></div>
    </div>
    <div class="stat-mini">
        <div class="stat-icon" style="background:rgba(245,158,11,.1);color:#f59e0b;"><i class="bi bi-flag"></i></div>
        <div><p class="stat-label">Hitos</p><h3 class="stat-value">@Model.Hitos.Count</h3></div>
    </div>
</div>

<!-- Estado del proyecto -->
@if (User.Identity.IsAuthenticated)
{
    <div class="table-card mb-4">
        <div class="p-4">
            <h6 class="mb-3" style="font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#64748b;font-weight:600;">Estado del Proyecto</h6>
            <form id="estadoProyectoForm" asp-action="GuardarCambios" method="post" class="d-flex gap-3 align-items-end">
                <input type="hidden" name="proyectoId" value="@Model.Id" />
                <div class="flex-grow-1" style="max-width:280px;">
                    @Html.DropDownListFor(
                        model => model.Estado,
                        new SelectList(Enum.GetValues(typeof(ProyectoSGIOCore.Models.EstadoProyecto))),
                        new { @class = "form-select", id = "EstadoProyecto", name = "Estado" })
                </div>
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-save me-1"></i>Guardar Estado
                </button>
            </form>
        </div>
    </div>
}

<!-- ====== CLIENTE ====== -->
<div class="table-card mb-4">
    <div class="p-4 d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-1" style="font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#64748b;font-weight:600;">Cliente Asignado</h6>
            @if (Model.Usuario != null)
            {
                <p class="mb-0 fw-500">@Model.Usuario.Nombre @Model.Usuario.Apellido</p>
                <p class="mb-0 text-muted" style="font-size:13px;">@Model.Usuario.Correo</p>
            }
            else
            {
                <p class="mb-0 text-muted" style="font-size:14px;">Sin cliente asignado</p>
            }
        </div>
        @if (User.Identity.IsAuthenticated)
        {
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAsignarCliente">
                <i class="bi bi-person-plus me-1"></i>@(Model.Usuario != null ? "Cambiar Cliente" : "Asignar Cliente")
            </button>
        }
    </div>
</div>

<!-- ====== FASES ====== -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-600">Fases y Tareas</h5>
    @if (User.Identity.IsAuthenticated)
    {
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAgregarFase">
            <i class="bi bi-plus-lg me-1"></i>Agregar Fase
        </button>
    }
</div>

@if (!Model.Fases.Any())
{
    <div class="table-card p-5 text-center text-muted mb-4">
        <i class="bi bi-stack" style="font-size:2.5rem;opacity:.25;"></i>
        <p class="mb-0 mt-3">Este proyecto no tiene fases todavía.</p>
    </div>
}

@foreach (var fase in Model.Fases)
{
    int faseTareas = fase.Tareas.Count;
    int faseOk = fase.Tareas.Count(t => t.Completada);
    int fasePct = faseTareas == 0 ? 0 : faseOk * 100 / faseTareas;

    <div class="table-card mb-3">
        <div class="p-4 pb-2 d-flex justify-content-between align-items-center border-bottom">
            <div>
                <span class="fw-600" style="font-size:15px;">@fase.Nombre</span>
                <span class="ms-2 text-muted" style="font-size:12px;">@faseOk/@faseTareas tareas · $@fase.CostoTotal.ToString("N2")</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div style="width:80px;">
                    <div class="progress" style="height:6px;border-radius:4px;">
                        <div class="progress-bar bg-primary" style="width:@fasePct%;border-radius:4px;"></div>
                    </div>
                    <p class="mb-0 text-end" style="font-size:11px;color:#94a3b8;">@fasePct%</p>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    <button type="button" class="btn btn-action delete" title="Eliminar fase"
                            data-bs-toggle="modal" data-bs-target="#modalEliminarFase_@fase.Id">
                        <i class="bi bi-trash"></i>
                    </button>
                }
            </div>
        </div>

        <div class="p-0">
            @if (!fase.Tareas.Any())
            {
                <p class="text-muted p-4 mb-0" style="font-size:13px;">Sin tareas en esta fase.</p>
            }
            else
            {
                <table class="sgio-table mb-0">
                    <thead>
                        <tr>
                            <th>Tarea</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Costo</th>
                            <th>Estado</th>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <th class="text-center">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tarea in fase.Tareas)
                        {
                            <tr>
                                <td class="fw-500">@tarea.Nombre</td>
                                <td class="text-muted" style="font-size:13px;">@tarea.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td class="text-muted" style="font-size:13px;">@tarea.FechaFin.ToString("dd/MM/yyyy")</td>
                                <td>$@(tarea.Costo?.ToString("N2") ?? "0.00")</td>
                                <td>
                                    <label class="d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                                        <input type="checkbox" id="chk_@tarea.Id" class="tarea-checkbox"
                                               data-tarea-id="@tarea.Id" @(tarea.Completada ? "checked" : "") />
                                        <span class="badge-status @(tarea.Completada ? "complete" : "pending")" id="badge_@tarea.Id">
                                            @(tarea.Completada ? "Completada" : "Pendiente")
                                        </span>
                                    </label>
                                </td>
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <td class="text-center">
                                        <button type="button" class="btn btn-action delete eliminar-tarea-btn"
                                                title="Eliminar tarea"
                                                data-tarea-id="@tarea.Id"
                                                data-tarea-nombre="@tarea.Nombre"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEliminarTarea">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (User.Identity.IsAuthenticated)
            {
                <div class="p-3 border-top">
                    <button type="button" class="btn btn-sm btn-outline-primary agregar-tareas-btn"
                            data-fase-id="@fase.Id">
                        <i class="bi bi-plus me-1"></i>Agregar Tarea
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Modal Eliminar Fase -->
    <div class="modal fade" id="modalEliminarFase_@fase.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar Fase</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    ¿Seguro que deseas eliminar la fase <strong>@fase.Nombre</strong> y todas sus tareas?
                    <p class="text-danger small mt-2 mb-0">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="EliminarFase" asp-controller="Proyecto" method="post" class="d-inline">
                        <input type="hidden" name="faseId" value="@fase.Id" />
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- ====== HITOS ====== -->
<div class="d-flex justify-content-between align-items-center mb-3 mt-4">
    <h5 class="mb-0 fw-600">Hitos del Proyecto</h5>
    @if (User.Identity.IsAuthenticated)
    {
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAgregarHito">
            <i class="bi bi-plus-lg me-1"></i>Agregar Hito
        </button>
    }
</div>

@if (!Model.Hitos.Any())
{
    <div class="table-card p-5 text-center text-muted mb-4">
        <i class="bi bi-flag" style="font-size:2.5rem;opacity:.25;"></i>
        <p class="mb-0 mt-3">No hay hitos registrados para este proyecto.</p>
    </div>
}
else
{
    <div class="table-card mb-4">
        <table class="sgio-table mb-0">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Responsable</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <th class="text-center">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var hito in Model.Hitos)
                {
                    string hitoBadge = hito.estado switch {
                        1 => "complete",
                        2 => "inactive",
                        3 => "progress",
                        4 => "complete",
                        5 => "inactive",
                        _ => "pending"
                    };
                    string hitoLabel = hito.estado switch {
                        1 => "Completo",
                        2 => "Pendiente",
                        3 => "En Progreso",
                        4 => "Aprobado",
                        5 => "Rechazado",
                        _ => "—"
                    };
                    <tr>
                        <td class="fw-500" style="max-width:260px;">@hito.Descripcion</td>
                        <td>@(hito.Usuario != null ? $"{hito.Usuario.Nombre} {hito.Usuario.Apellido}" : "—")</td>
                        <td class="text-muted" style="font-size:13px;">@hito.Fecha.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge-status @hitoBadge">@hitoLabel</span></td>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <button type="button" class="btn btn-action edit editar-hito-btn"
                                            title="Editar hito"
                                            data-hito-id="@hito.ID"
                                            data-descripcion="@hito.Descripcion"
                                            data-usuario-id="@hito.IdUsuario"
                                            data-estado-actual="@hito.estado"
                                            data-fecha="@hito.Fecha.ToString("yyyy-MM-dd")"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarHito">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-action delete"
                                            title="Eliminar hito"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminarHito_@hito.ID">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        }
                    </tr>

                    <!-- Modal Eliminar Hito -->
                    <div class="modal fade" id="modalEliminarHito_@hito.ID" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Eliminar Hito</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    ¿Seguro que deseas eliminar el hito <strong>@hito.Descripcion</strong>?
                                    <p class="text-danger small mt-2 mb-0">Esta acción no se puede deshacer.</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <form asp-action="EliminarHito" asp-controller="Proyecto" method="post" class="d-inline">
                                        <input type="hidden" name="hitoId" value="@hito.ID" />
                                        <button type="submit" class="btn btn-danger">Eliminar</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
}

<!-- ====== MODAL: Agregar Fase ====== -->
<div class="modal fade" id="modalAgregarFase" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nueva Fase</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AgregarFase" asp-controller="Proyecto" method="post">
                <div class="modal-body">
                    <input type="hidden" name="proyectoId" value="@Model.Id" />
                    <label class="form-label">Nombre de la Fase <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="Nombre" placeholder="Ej: Fundaciones" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Agregar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ====== MODAL: Agregar Tarea ====== -->
<div class="modal fade" id="modalAgregarTarea" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalAgregarTareaLabel">Agregar Tarea</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="alertContainerTarea" class="mb-3"></div>
                <form id="formAgregarTareas" novalidate>
                    <input type="hidden" id="faseIdHidden" name="faseId" />
                    <div class="mb-3">
                        <label class="form-label">Nombre de la Tarea <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="inputTareaNombre" name="tareas[0].Nombre" required placeholder="Nombre de la tarea" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">Fecha Inicio <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="inputFechaInicio" name="tareas[0].FechaInicio" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Fecha Fin <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="inputFechaFin" name="tareas[0].FechaFin" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Costo ($)</label>
                        <input type="number" class="form-control" id="inputCosto" name="tareas[0].Costo" min="0" step="0.01" placeholder="0.00" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnSubmitTarea">
                    <i class="bi bi-plus me-1"></i>Agregar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ====== MODAL: Eliminar Tarea ====== -->
<div class="modal fade" id="modalEliminarTarea" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Eliminar Tarea</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Seguro que deseas eliminar la tarea <strong id="tareaEliminarNombre"></strong>?
                <p class="text-danger small mt-2 mb-0">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" action="@Url.Action("EliminarTarea", "Proyecto")" class="d-inline">
                    <input type="hidden" name="tareaId" id="tareaEliminarId" />
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ====== MODAL: Agregar Hito ====== -->
<div class="modal fade" id="modalAgregarHito" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo Hito</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AsignarHito" method="post">
                <input type="hidden" name="id" value="@ViewBag.ProyectoId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Descripción <span class="text-danger">*</span></label>
                        <textarea name="Descripcion" class="form-control" rows="3" placeholder="Descripción del hito" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Responsable <span class="text-danger">*</span></label>
                        <select name="usuarioId" asp-items="ViewBag.Usuarios" class="form-select" required>
                            <option value="">Seleccione un empleado</option>
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Estado</label>
                            <select name="estadoId" asp-items="ViewBag.EstadosHito" class="form-select">
                                <option value="">Seleccione estado</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Fecha</label>
                            <input type="date" name="Fecha" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Hito</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ====== MODAL: Asignar Cliente ====== -->
<div class="modal fade" id="modalAsignarCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-person-plus me-2"></i>
                    @(Model.Usuario != null ? "Cambiar Cliente" : "Asignar Cliente")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AsignarCliente" asp-controller="Proyecto" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="usuarioId" id="clienteSeleccionadoId" />
                <div class="modal-body">
                    <!-- Lista de clientes -->
                    <div id="listaClientes"
                         style="max-height:340px;overflow-y:auto;border:1px solid #e2e8f0;border-radius:8px;">
                        @{
                            var clientes = ViewBag.Clientes as List<ProyectoSGIOCore.Models.Usuario>;
                        }
                        @if (clientes == null || !clientes.Any())
                        {
                            <div class="p-4 text-center text-muted" style="font-size:14px;">
                                <i class="bi bi-people" style="font-size:2rem;opacity:.3;"></i>
                                <p class="mb-0 mt-2">No hay clientes registrados con rol Usuario.</p>
                            </div>
                        }
                        else
                        {
                            foreach (var cliente in clientes)
                            {
                                bool esActual = Model.Usuario?.IdUsuario == cliente.IdUsuario;
                                <div class="cliente-item d-flex align-items-center gap-3 p-3 @(esActual ? "selected" : "")"
                                     data-id="@cliente.IdUsuario"
                                     data-nombre="@cliente.Nombre @cliente.Apellido"
                                     data-correo="@cliente.Correo"
                                     style="cursor:pointer;border-bottom:1px solid #f1f5f9;transition:background .15s;@(esActual ? "background:#eff6ff;" : "")">
                                    <div class="d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#3e64ff20,#3e64ff40);color:#3e64ff;font-weight:700;font-size:14px;">
                                        @cliente.Nombre.Substring(0, 1).ToUpper()@cliente.Apellido.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="flex-grow-1">
                                        <p class="mb-0 fw-500" style="font-size:14px;">@cliente.Nombre @cliente.Apellido</p>
                                        <p class="mb-0 text-muted" style="font-size:12px;">@cliente.Correo</p>
                                    </div>
                                    <div class="check-icon" style="display:@(esActual ? "block" : "none");">
                                        <i class="bi bi-check-circle-fill text-primary"></i>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <!-- Cliente seleccionado -->
                    <div id="clienteSeleccionadoInfo" class="mt-3" style="display:@(Model.Usuario != null ? "" : "none");">
                        <div class="d-flex align-items-center gap-2 p-2 rounded" style="background:#eff6ff;font-size:13px;">
                            <i class="bi bi-person-check-fill text-primary"></i>
                            <span>Seleccionado: <strong id="clienteSeleccionadoNombre">@(Model.Usuario != null ? $"{Model.Usuario.Nombre} {Model.Usuario.Apellido}" : "")</strong></span>
                        </div>
                    </div>
                    <div id="sinClienteSeleccionado" class="mt-3" style="display:@(Model.Usuario != null ? "none" : "");">
                        <p class="text-muted mb-0" style="font-size:13px;">
                            <i class="bi bi-info-circle me-1"></i>Haz clic en un cliente para seleccionarlo.
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnAsignarCliente" @(Model.Usuario != null ? "" : "disabled")>
                        <i class="bi bi-check-lg me-1"></i>Asignar Cliente
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ====== MODAL: Editar Hito ====== -->
<div class="modal fade" id="modalEditarHito" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Editar Hito</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditarHito" asp-controller="Proyecto" method="post">
                <input type="hidden" name="hitoId" id="editarHitoId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Descripción <span class="text-danger">*</span></label>
                        <textarea name="Descripcion" id="editarHitoDescripcion" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Responsable <span class="text-danger">*</span></label>
                        <select name="usuarioId" id="editarHitoUsuario" asp-items="ViewBag.Usuarios" class="form-select" required>
                            <option value="">Seleccione un empleado</option>
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Estado</label>
                            <select name="estadoId" id="editarEstadoSelect" class="form-select">
                                <option value="1">Completo</option>
                                <option value="2">Pendiente</option>
                                <option value="3">En Progreso</option>
                                <option value="4">Aprobado</option>
                                <option value="5">Rechazado</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Fecha</label>
                            <input type="date" name="Fecha" id="editarHitoFecha" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ---- Checkboxes de tareas (guardar sin recargar) ----
document.querySelectorAll('.tarea-checkbox').forEach(chk => {
    chk.addEventListener('change', function() {
        const tareaId = this.dataset.tareaId;
        const completada = this.checked;
        const badge = document.getElementById(`badge_${tareaId}`);
        if (badge) {
            badge.textContent = completada ? 'Completada' : 'Pendiente';
            badge.className = `badge-status ${completada ? 'complete' : 'pending'}`;
        }
        const payload = { [tareaId]: completada };
        fetch('@Url.Action("ActualizarTareas", "Proyecto")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        }).then(r => r.json()).then(data => {
            if (data.message) {
                const a = document.getElementById('alertAjax');
                document.getElementById('alertAjaxMsg').textContent = data.message;
                a.style.display = '';
                setTimeout(() => a.style.display = 'none', 2500);
            }
        }).catch(console.error);
    });
});

// ---- Abrir modal agregar tarea ----
document.querySelectorAll('.agregar-tareas-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
        const faseId = this.dataset.faseId;
        try {
            const res = await fetch(`/Proyecto/ObtenerFase?faseId=${faseId}`);
            const data = await res.json();
            document.getElementById('modalAgregarTareaLabel').textContent = `Agregar Tarea — ${data.nombre}`;
            document.getElementById('faseIdHidden').value = data.id;
            document.getElementById('formAgregarTareas').reset();
            document.getElementById('alertContainerTarea').innerHTML = '';
            new bootstrap.Modal(document.getElementById('modalAgregarTarea')).show();
        } catch { }
    });
});

// ---- Enviar tarea via AJAX ----
document.getElementById('btnSubmitTarea').addEventListener('click', async function() {
    const nombre = document.getElementById('inputTareaNombre').value.trim();
    const ini    = document.getElementById('inputFechaInicio').value;
    const fin    = document.getElementById('inputFechaFin').value;

    if (!nombre) { mostrarAlertaTarea('El nombre de la tarea es obligatorio.', 'danger'); return; }
    if (!ini || !fin) { mostrarAlertaTarea('Las fechas de inicio y fin son obligatorias.', 'danger'); return; }
    if (new Date(ini) >= new Date(fin)) { mostrarAlertaTarea('La fecha de fin debe ser posterior a la de inicio.', 'danger'); return; }

    const form = document.getElementById('formAgregarTareas');
    const body = new FormData(form);

    try {
        const res = await fetch('/Proyecto/AgregarTareasModal', { method: 'POST', body });
        const result = await res.json();

        if (res.ok && result.exito) {
            mostrarAlertaTarea(result.mensaje, 'success');
            setTimeout(() => {
                bootstrap.Modal.getInstance(document.getElementById('modalAgregarTarea')).hide();
                location.reload();
            }, 1200);
        } else {
            mostrarAlertaTarea(result.mensaje || 'Error al agregar la tarea.', 'danger');
        }
    } catch {
        mostrarAlertaTarea('Error de conexión. Intente de nuevo.', 'danger');
    }
});

function mostrarAlertaTarea(msg, tipo) {
    document.getElementById('alertContainerTarea').innerHTML =
        `<div class="alert alert-${tipo} alert-dismissible fade show py-2 mb-0" role="alert">
            ${msg}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>`;
}

// ---- Eliminar tarea: pasar datos al modal ----
document.querySelectorAll('.eliminar-tarea-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.getElementById('tareaEliminarNombre').textContent = this.dataset.tareaNombre;
        document.getElementById('tareaEliminarId').value = this.dataset.tareaId;
    });
});

// ---- Editar hito ----
document.querySelectorAll('.editar-hito-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.getElementById('editarHitoId').value = this.dataset.hitoId;
        document.getElementById('editarHitoDescripcion').value = this.dataset.descripcion;
        document.getElementById('editarHitoUsuario').value = this.dataset.usuarioId;
        document.getElementById('editarEstadoSelect').value = this.dataset.estadoActual;
        document.getElementById('editarHitoFecha').value = this.dataset.fecha;
    });
});

// ---- Asignar cliente: búsqueda y selección ----
(function() {
    const hiddenId      = document.getElementById('clienteSeleccionadoId');
    const nombreDisplay = document.getElementById('clienteSeleccionadoNombre');
    const infoBox       = document.getElementById('clienteSeleccionadoInfo');
    const sinSeleccion  = document.getElementById('sinClienteSeleccionado');
    const btnAsignar    = document.getElementById('btnAsignarCliente');

    function getItems() {
        return document.querySelectorAll('.cliente-item');
    }

    // Selección de cliente (delegación al contenedor para capturar items al momento)
    const lista = document.getElementById('listaClientes');
    if (lista) {
        lista.addEventListener('click', function(e) {
            const item = e.target.closest('.cliente-item');
            if (!item) return;

            getItems().forEach(function(i) {
                i.style.background = '';
                const ic = i.querySelector('.check-icon');
                if (ic) ic.style.display = 'none';
            });

            item.style.background = '#eff6ff';
            const ic = item.querySelector('.check-icon');
            if (ic) ic.style.display = 'block';

            hiddenId.value = item.dataset.id;
            nombreDisplay.textContent = item.dataset.nombre;
            infoBox.style.display = '';
            sinSeleccion.style.display = 'none';
            if (btnAsignar) btnAsignar.removeAttribute('disabled');
        });

        // Hover delegado
        lista.addEventListener('mouseover', function(e) {
            const item = e.target.closest('.cliente-item');
            if (item && item.style.background !== 'rgb(239, 246, 255)') item.style.background = '#f8fafc';
        });
        lista.addEventListener('mouseout', function(e) {
            const item = e.target.closest('.cliente-item');
            if (item && hiddenId && item.dataset.id !== hiddenId.value) item.style.background = '';
        });
    }
})();
</script>
}
